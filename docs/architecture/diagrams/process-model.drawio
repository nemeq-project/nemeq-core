  <diagram id="lifecycle" name="2 · Процессы, сон, fencing">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="chain" value="anima  →  0..N инкарнаций  →  0..N generation  →  1 systemd unit + 1 leaf-cgroup  →  0..N процессов ОС" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#1a4d8f;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="st_dormant" value="dormant&#10;0 процессов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st_start" value="starting&#10;unit создан, limits до exec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#b26a00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="140" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st_run" value="running&#10;1 main + 0..N children" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#2e7d32;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="140" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st_sleep" value="sleeping&#10;checkpoint, cgroup пуст, unit удалён" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a4d8f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="140" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st_dead" value="dead&#10;0 процессов, epoch fenced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b71c1c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="140" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_dormant" target="st_start"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_start" target="st_run"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_run" target="st_sleep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="st_run" target="st_dead"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="st_sleep" target="st_start"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="fence" value="ПОРЯДОК FENCING (жёсткий)&#10;1. durable bump epoch&#10;2. cgroup.kill по leaf-cgroup&#10;3. ждать cgroup.events: populated=0&#10;4. смена владельца / состояния&#10;5. новая generation при следующем запуске" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#b71c1c;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="520" height="180" as="geometry" />
        </mxCell>

        <mxCell id="sale" value="ПРОДАЖА .anima&#10;quiesce → fence → отзыв qatum → смена владельца → новая generation&#10;.anima = переносимый артефакт, НЕ действующая авторизация" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9ff;strokeColor=#1a4d8f;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="270" width="540" height="180" as="geometry" />
        </mxCell>

        <mxCell id="spawn" value="ЗАПУСК (критика Opus)&#10;.scope создаётся для уже работающего процесса → окно без лимитов и возможный fork вне инкарнации.&#10;Поэтому: transient .service с ExecStart (лимиты до exec)&#10;ИЛИ Delegate=yes + clone3(CLONE_INTO_CGROUP). Смешивать нельзя." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#b26a00;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="520" height="150" as="geometry" />
        </mxCell>

        <mxCell id="py" value="PYTHON → RUST (что не меняется)&#10;kalam_id · anima_id · incarnation_id · generation&#10;дерево cgroup · state machine · capability-модель&#10;формат аудита · IPC · правила сна и смерти" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#2e7d32;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="480" width="540" height="150" as="geometry" />
        </mxCell>

        <mxCell id="inv" value="ИНВАРИАНТЫ&#10;1. процесс ∈ ровно один leaf-cgroup одного Kalam; Awilu — ровно одна incarnation+generation&#10;2. PID ≠ идентичность&#10;3. ограничения применяются ДО exec&#10;4. граница capability не слабее границы отказа&#10;5. sleeping/dead ⇒ пустой cgroup; running с пустым cgroup = отказ&#10;6. запуск только через systemd .service или clone3 в делегированную cgroup&#10;7. epoch durable-bump ДО kill; idempotency привязана к epoch&#10;8. в API Libbu нет доменных слов harness (проверка в CI)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1100" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
