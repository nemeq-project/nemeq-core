        </mxCell>

        <mxCell id="legend" value="Epishu = любой агент → Subur (служебный) | Awilu (целевой). PID — не идентичность: идентичность = UUID + generation + cgroup." style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="765" width="1120" height="40" as="geometry" />
